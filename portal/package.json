{
  "name": "portal",
  "description": "Personal portal listing saved links",
  "engines": {
    "bun": ">=1.4.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "bun run links",
    "build": "qwik build",
    "prebuild.client": "bun run links",
    "build.client": "vite build",
    "prebuild.preview": "bun run links",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "prebuild.types": "bun run links",
    "build.types": "tsc --incremental --noEmit",
    "predev": "bun run links",
    "dev": "vite --mode ssr",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "prelint": "bun run links",
    "lint": "eslint \"src/**/*.ts*\"",
    "prepreview": "bun run links",
    "preview": "qwik build preview && vite preview --open",
    "previews": "bun scripts/capture-previews.ts",
    "prestart": "bun run links",
    "start": "vite --open --mode ssr",
    "qwik": "qwik",
    "links": "bun scripts/collect-links.ts"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.0",
    "@builder.io/qwik-city": "^1.20.0",
    "@eslint/js": "^9",
    "@types/node": "20.19.0",
    "eslint": "9.32.0",
    "eslint-plugin-qwik": "^1.20.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript": "5.4.5",
    "typescript-eslint": "8.38.0",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "^4.2.1"
  }
}
