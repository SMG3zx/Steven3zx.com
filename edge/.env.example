# Copy to edge/.env and fill in. Never commit edge/.env.

# Cloudflare token for the ddns container (Zone.DNS edit on steven3zx.com).
CLOUDFLARE_API_TOKEN=

# Bearer token shared by the host agent and the admin container, at least 32 characters.
HOST_AGENT_TOKEN=

# Encryption key for the admin database, 64 hex characters: openssl rand -hex 32
# Losing it loses admin.db. Keep a copy in a password manager too.
ADMIN_DB_KEY=
