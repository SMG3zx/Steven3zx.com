# Containerised edge proxy. Sites that still run on the Windows host are
# reached through host.docker.internal; the portfolio runs as a sibling
# container on the compose network.

janus.steven3zx.com {
	@grafana path /grafana /grafana/*
	handle @grafana {
		reverse_proxy host.docker.internal:3000
	}
	handle {
		reverse_proxy host.docker.internal:9091
	}
}

git.steven3zx.com {
	reverse_proxy host.docker.internal:30001
}

plane.steven3zx.com {
	reverse_proxy host.docker.internal:8080
}

www.steven3zx.com {
	@admin path /admin /admin/*
	handle @admin {
		reverse_proxy admin:8091
	}
	handle {
		reverse_proxy portfolio:8090
	}
}

steven3zx.com {
	redir https://www.steven3zx.com{uri} permanent
}
