{
  "$schema": "https://aka.ms/codetour-schema",
  "title": "Deployment flow: queueing, the checks gate, and the Agent handoff",
  "description": "Follows one Deploy from its refusals, through the Agent handoff, to the state changes that end it. Covers ENG-108.",
  "steps": [
    {
      "file": "janus-go/internal/app/deployments.go",
      "line": 67,
      "title": "Refusals come first",
      "description": "`func (d *Deployments) Create` refuses an incomplete build, a running or failed Check, and an unknown Agent, before any record is written."
    },
    {
      "file": "janus-go/internal/app/deployments.go",
      "line": 102,
      "title": "Up-front Agent check",
      "description": "`d.deployer.Ready(` refuses a paused, offline or missing Agent before a Deployment is created."
    },
    {
      "file": "janus-go/internal/app/fleet.go",
      "line": 170,
      "title": "What Ready checks",
      "description": "`func (f *Fleet) Ready` reports whether the Owner's Agent is connected and not paused."
    },
    {
      "file": "janus-go/internal/app/deployments.go",
      "line": 174,
      "title": "The Deployment runs in the background",
      "description": "`func (d *Deployments) run` runs on its own goroutine. The request has already returned queued."
    },
    {
      "file": "janus-go/internal/app/deployments.go",
      "line": 183,
      "title": "Queued to starting",
      "description": "`From: string(deployments.Queued)` moves the Deployment to starting. The Store compares the state it saw, so a concurrent change is detected."
    },
    {
      "file": "janus-go/internal/app/deployments.go",
      "line": 187,
      "title": "The Agent handoff",
      "description": "`d.deployer.Deploy(` hands the module to the Agent, and blocks until the Agent reports it healthy or refuses it."
    },
    {
      "file": "janus-go/internal/app/fleet.go",
      "line": 197,
      "title": "Fleet sends the command",
      "description": "`func (f *Fleet) Deploy` sends the Deploy command over AgentLink, and the Agent answers with its state."
    },
    {
      "file": "janus-go/internal/app/deployments.go",
      "line": 200,
      "title": "Every failure ends here",
      "description": "`func (d *Deployments) fail` ends a Deployment as failed from whichever state it is in. It uses its own context, so a timeout cannot leave it in flight."
    },
    {
      "file": "janus-go/internal/domain/deployments/deployments.go",
      "line": 29,
      "title": "The state machine",
      "description": "`func CanMove` says which moves are legal. The transitions themselves are listed in the machine map just above it."
    },
    {
      "file": "janus-go/internal/adapters/sqlstore/deployments.go",
      "line": 91,
      "title": "Compare and swap in SQLite",
      "description": "`func (s *Store) TransitionDeployment` writes the move only if the stored state is still the one the caller saw."
    },
    {
      "file": "janus-go/internal/adapters/sqlstore/store.go",
      "line": 289,
      "title": "The one-in-flight rule in the schema",
      "description": "`CREATE UNIQUE INDEX IF NOT EXISTS one_inflight_deployment_per_project` backs the rule with a partial unique index, so the database enforces it too."
    }
  ]
}
