{
  "$schema": "https://aka.ms/codetour-schema",
  "title": "Job resume: what a restart does to imports and builds",
  "description": "How a restart affects jobs: WASM Builds run under the job runner and are recovered from janus.db at startup; Imports are JetStream jobs of the projects service that are handed out again.",
  "steps": [
    {
      "file": "janus-go/internal/app/jobrunner.go",
      "line": 59,
      "title": "Jobs start under a limit",
      "description": "`func (r *JobRunner) Start` runs a job on a goroutine the runner owns, and refuses when the runner is shutting down."
    },
    {
      "file": "janus-go/internal/app/jobrunner.go",
      "line": 88,
      "title": "A crash becomes a failed job",
      "description": "`func (r *JobRunner) run` runs the job and hands any panic to the crashed callback, so a bad job fails without taking the process down."
    },
    {
      "file": "janus-go/internal/adapters/sqlstore/jobs.go",
      "line": 105,
      "title": "Recovery at startup",
      "description": "`func migrateAndRecoverJobs` moves WASM Builds that were running at the last shutdown back to queued, so they can resume."
    },
    {
      "file": "janus-go/internal/adapters/sqlstore/jobs.go",
      "line": 172,
      "title": "The resume limit",
      "description": "`func recoverJobTable` counts resumes and fails a job that has been interrupted too many times, instead of retrying it forever."
    },
    {
      "file": "janus-go/internal/services/projects/imports.go",
      "line": 200,
      "title": "Imports resume on redelivery",
      "description": "`func (s *Service) handleImport` gets an Import's job again when its worker stopped. It moves the Import back to queued and resumes from its Staging Snapshot, and on the last delivery fails it instead of retrying forever."
    },
    {
      "file": "janus-go/internal/app/builds.go",
      "line": 147,
      "title": "Builds resume",
      "description": "`func (b *Builds) Resume` restarts each interrupted build from scratch. A build whose language no longer has a builder fails instead."
    },
    {
      "file": "janus-go/internal/app/jobrunner.go",
      "line": 139,
      "title": "Shutdown waits for jobs",
      "description": "`func (r *JobRunner) Drain` stops accepting new jobs and waits for the running ones, or for the context to end."
    }
  ]
}
