{
  "$schema": "https://aka.ms/codetour-schema",
  "title": "Usage recording: from an Agent's report to an Owner's usage page",
  "description": "How a run's fuel, memory, time and network bytes travel from the Agent to the Store, and how an Owner reads them back.",
  "steps": [
    {
      "file": "janus-go/internal/domain/usage/usage.go",
      "line": 15,
      "title": "What a run consumed",
      "description": "`type Usage struct` holds the fuel, peak memory, time and CPU a run used, as measured by the host."
    },
    {
      "file": "janus-go/internal/app/port_types.go",
      "line": 171,
      "title": "What an Agent reports",
      "description": "`type RunReport struct` is one run as the Agent measured it, including network bytes and the status. A run that failed still reports what it spent."
    },
    {
      "file": "janus-go/internal/app/fleet.go",
      "line": 121,
      "title": "The Fleet receives reports",
      "description": "`func (f *Fleet) receiver` handles each event from an Agent and records its usage under the Owner of that Agent, whatever the report says."
    },
    {
      "file": "janus-go/internal/app/store_types.go",
      "line": 352,
      "title": "What the Store keeps",
      "description": "`type RunUsageRecord struct` pairs a run with its Owner and Agent. The Owner is always the Agent's, never a value the Agent sent."
    },
    {
      "file": "janus-go/internal/adapters/sqlstore/agents.go",
      "line": 128,
      "title": "Recorded once",
      "description": "`func (s *Store) RecordRunUsage` keeps a run once. Recording the same run ID again changes nothing."
    },
    {
      "file": "janus-go/internal/app/fleet.go",
      "line": 215,
      "title": "An Owner reads their usage",
      "description": "`func (f *Fleet) Usage` returns only the Owner's own runs, newest first."
    }
  ]
}
