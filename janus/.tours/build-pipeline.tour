{
  "$schema": "https://aka.ms/codetour-schema",
  "title": "Build pipeline: compile, then Check, then the Artifact",
  "description": "Follows a WASM build from its request, through the compile and the Check that gates Deploy, to the stored Artifact.",
  "steps": [
    {
      "file": "janus-go/internal/services/gateway/buildsclient/gateway.go",
      "line": 51,
      "title": "A build is requested",
      "description": "`func (g *Gateway) Request` asks the builds service to queue a Build of a Snapshot. The build runs in the builds service, not here."
    },
    {
      "file": "janus-go/internal/services/builds/requests.go",
      "line": 22,
      "title": "The builds service queues it",
      "description": "`func (s *Service) requestBuild` checks the target and the Language with the projects service, then records the build and queues its job in one transaction."
    },
    {
      "file": "janus-go/internal/services/builds/worker.go",
      "line": 70,
      "title": "A worker takes the job",
      "description": "`func (s *Service) handleBuild` takes the job from JOBS. It acknowledges the job only once the build is finished, so a worker that dies hands it to another."
    },
    {
      "file": "janus-go/internal/services/builds/worker.go",
      "line": 272,
      "title": "The source is paged in",
      "description": "`func (s *Service) fetchSource` copies the snapshot's files from the projects service into a temporary workspace, one page at a time."
    },
    {
      "file": "janus-go/internal/services/builds/worker.go",
      "line": 236,
      "title": "The compile is the outbound call",
      "description": "`s.cfg.Compile(` is the outbound call. The service does not know that Docker is behind it."
    },
    {
      "file": "janus-go/internal/services/builds/docker/builder.go",
      "line": 68,
      "title": "The Docker compiler",
      "description": "`func (d *Docker) Build` picks the command for the Language and runs it in an isolated container with no network."
    },
    {
      "file": "janus-go/internal/services/builds/worker.go",
      "line": 250,
      "title": "The Artifact is stored",
      "description": "`completeBuild(` runs only after the compile finished, so an unfinished build never has an Artifact."
    },
    {
      "file": "janus-go/internal/services/builds/worker.go",
      "line": 319,
      "title": "The Check runs after a successful build",
      "description": "`func (s *Service) check` runs the Language's checks on the same workspace. A failed Check holds back Deploy; the build stays complete."
    },
    {
      "file": "janus-go/internal/services/builds/worker.go",
      "line": 334,
      "title": "The check is the outbound call",
      "description": "`s.cfg.Check(` is the outbound call for the test commands."
    },
    {
      "file": "janus-go/internal/services/builds/docker/check.go",
      "line": 32,
      "title": "Each Language's test command",
      "description": "`var checkSpecs` holds the test command for each Language, and how that Language's output shows that no test ran."
    },
    {
      "file": "janus-go/internal/services/builds/docker/check.go",
      "line": 39,
      "title": "A failing test is a result",
      "description": "`func (d *Docker) Check` treats a failing test as a result, and a container that cannot run as an error. The check records both."
    },
    {
      "file": "janus-go/internal/services/builds/worker.go",
      "line": 145,
      "title": "The outcome is audited",
      "description": "`func (s *Service) finished` writes the audit event for how the build ended."
    },
    {
      "file": "janus-go/internal/services/builds/store.go",
      "line": 127,
      "title": "The Store keeps the Artifact",
      "description": "`func completeBuild` writes the Artifact and its log to builds.db, and only for a build that is still running. The artifacts store gets a copy afterwards."
    }
  ]
}
