{
  "$schema": "https://aka.ms/codetour-schema",
  "title": "Project import: from a GitHub branch to an active Snapshot",
  "description": "How a repository commit becomes an active Snapshot in the projects service: the Import is recorded and its job queued through the outbox, a worker takes the job from the JOBS stream, clones and scans the commit, stores a Staging Snapshot, and completes it.",
  "steps": [
    {
      "file": "janus-go/internal/services/projects/imports.go",
      "line": 28,
      "title": "An Import is requested",
      "description": "`func (s *Service) requestImport` checks the repository, branch and commit with GitHub, then records the Import and adds its job message to the outbox in one transaction. The request returns before any file is fetched."
    },
    {
      "file": "janus-go/internal/platform/outbox/outbox.go",
      "line": 140,
      "title": "The job reaches JOBS",
      "description": "`func (r *Relay) Flush` publishes the outbox to JetStream with each message's ID, so the job is sent if and only if the Import was stored."
    },
    {
      "file": "janus-go/internal/services/projects/imports.go",
      "line": 200,
      "title": "A worker takes the job",
      "description": "`func (s *Service) handleImport` runs one delivery of the job, keeps it alive while it runs, and acknowledges it only once the Import has finished."
    },
    {
      "file": "janus-go/internal/services/projects/pipeline.go",
      "line": 40,
      "title": "The Import runs",
      "description": "`func (s *Service) runImport` gets the Owner's GitHub token from the identity service, then resumes from a Staging Snapshot or starts from a fresh clone."
    },
    {
      "file": "janus-go/internal/services/projects/source.go",
      "line": 48,
      "title": "The commit is cloned",
      "description": "`func (g *gitSource) open` clones the branch's last 50 commits and opens the commit's tree. No repository code runs."
    },
    {
      "file": "janus-go/internal/domain/scan/scan.go",
      "line": 72,
      "title": "The scan is pure",
      "description": "`func Files` picks the language with the most files and lists entrypoint candidates. It runs no repository code."
    },
    {
      "file": "janus-go/internal/services/projects/pipeline.go",
      "line": 202,
      "title": "The Staging Snapshot is kept",
      "description": "`func (s *Service) importFromClone` records the Staging Snapshot with its manifest before any file is written, so a redelivered job resumes it."
    },
    {
      "file": "janus-go/internal/services/projects/pipeline.go",
      "line": 286,
      "title": "The Snapshot becomes active",
      "description": "`func (s *Service) completeImport` makes the Snapshot active, completes the Import and keeps the newest five, adding a snapshot_deleted event for each one dropped."
    }
  ]
}
