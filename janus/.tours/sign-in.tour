{
  "$schema": "https://aka.ms/codetour-schema",
  "title": "Sign-in and accounts",
  "description": "How a person registers, signs in, and gets a session, and how a Google or GitHub sign-in finds its Account.",
  "steps": [
    {
      "file": "janus-go/internal/adapters/httpapi/server.go",
      "line": 199,
      "title": "Registration",
      "description": "`func (a *Server) register` creates a local Account and issues a session cookie."
    },
    {
      "file": "janus-go/internal/adapters/httpapi/server.go",
      "line": 230,
      "title": "Sign-in",
      "description": "`func (a *Server) login` checks the password, then issues a session. A wrong password and an unknown email get the same answer."
    },
    {
      "file": "janus-go/internal/domain/authn/authn.go",
      "line": 54,
      "title": "Passwords are compared, not read",
      "description": "`func (s *Authentication) VerifyPassword` checks the password against a stored hash. The password itself is never stored."
    },
    {
      "file": "janus-go/internal/domain/authn/authn.go",
      "line": 60,
      "title": "Issuing a session token",
      "description": "`func (s *Authentication) IssueToken` signs a token for the Account, with an expiry, using the server secret."
    },
    {
      "file": "janus-go/internal/domain/authn/authn.go",
      "line": 67,
      "title": "Every request checks its token",
      "description": "`func (s *Authentication) ValidateToken` returns the subject a valid token belongs to, and nothing for an invalid one."
    },
    {
      "file": "janus-go/internal/adapters/identityowners/owners.go",
      "line": 36,
      "title": "The identity use cases",
      "description": "`func New` builds the use cases for Accounts and sign-in methods, over the Identities port (the identity service). Every User it creates or signs in is also added to the Store as an Owner."
    },
    {
      "file": "janus-go/internal/adapters/identityowners/owners.go",
      "line": 65,
      "title": "Google and GitHub sign-ins",
      "description": "`func (r *Registry) ResolveGoogleIdentity` finds the Account for a Google sign-in through its Provider Identity, or creates one. GitHub works the same way."
    }
  ]
}
