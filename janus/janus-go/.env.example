JANUS_HTTP_ADDRESS=:9090
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PYROSCOPE_SERVER_ADDRESS=http://localhost:4040
JANUS_DATABASE_PATH=data/janus.db
JANUS_JWT_SECRET=
JANUS_JWT_ISSUER=janus-go
JANUS_JWT_EXPIRY=30m
JANUS_COOKIE_SECURE=false
JANUS_WASM_BUILDER_IMAGE=janus-rust-wasm-builder:local
JANUS_GO_WASM_BUILDER_IMAGE=janus-go-wasm-builder:local

# Optional Google OAuth. Set all three values to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:9090/auth/google/callback

# Optional GitHub OAuth App. Login asks for read:user and user:email; linking GitHub
# later asks for repo access so users can import private repositories.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:9090/auth/github/callback

# Optional Agent enrollment through a Headscale tailnet. Set HEADSCALE_URL and
# HEADSCALE_API_KEY together (create the key with `headscale apikeys create`).
# HEADSCALE_CONTROL_URL is the address Agents join; it defaults to HEADSCALE_URL.
HEADSCALE_URL=
HEADSCALE_API_KEY=
HEADSCALE_CONTROL_URL=

# Local Grafana login for docker compose. Change both before exposing the UI.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-sharing
