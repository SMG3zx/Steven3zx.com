# Trusted builder for Rust WASM Builds and Checks. Containers run with no network
# and cargo offline, so this image is the only place a crate's dependencies can
# come from: vendor them into the project or add a cache here.
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable \
    && rustup target add wasm32-unknown-unknown wasm32-wasip1

WORKDIR /workspace
