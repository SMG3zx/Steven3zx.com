    },
    {
      "id": "fZt7zYUyrEcGvHJ0dDv8w",
      "type": "text",
      "x": 4133.545123590162,
      "y": -931.8252348160511,
      "width": 678.3795166015625,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "fcfhMTW2UVjrfH8HYDKZN",
        "zJcaD6WfDZT99abAczHKX"
      ],
      "frameId": null,
      "index": "b1C",
      "roundness": null,
      "seed": 840351442,
      "version": 452,
      "versionNonce": 1354145938,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792218708513,
      "link": null,
      "locked": false,
      "text": "// Greeter is the actor. State lives in unexported fields; no locks are\n// needed because an actor processes one message at a time.\ntype Greeter struct {\n        greeted int\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Greeter is the actor. State lives in unexported fields; no locks are\n// needed because an actor processes one message at a time.\ntype Greeter struct {\n        greeted int\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "GOJ3I3kk43wdvw6Dh3yCX",
      "type": "text",
      "x": 4133.545123937815,
      "y": -791.5099475930541,
      "width": 1072.139404296875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "fcfhMTW2UVjrfH8HYDKZN",
        "zJcaD6WfDZT99abAczHKX"
      ],
      "frameId": null,
      "index": "b1D",
      "roundness": null,
      "seed": 1813537490,
      "version": 398,
      "versionNonce": 1979235922,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792218708513,
      "link": null,
      "locked": false,
      "text": "In order for the actor to be considered an actor to the framework we need to implement the actor interface\n\n\nPreStart(ctx *Context) error\nReceive(ctx *ReceiveContext)\nPostStop(ctx *Context) error",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In order for the actor to be considered an actor to the framework we need to implement the actor interface\n\n\nPreStart(ctx *Context) error\nReceive(ctx *ReceiveContext)\nPostStop(ctx *Context) error",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kIljRJuwGMkwc7-rtCSnF",
      "type": "text",
      "x": 4133.545124349274,
      "y": -602.7323400045115,
      "width": 721.339599609375,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "fcfhMTW2UVjrfH8HYDKZN",
        "zJcaD6WfDZT99abAczHKX"
      ],
      "frameId": null,
      "index": "b1E",
      "roundness": null,
      "seed": 1547547346,
      "version": 279,
      "versionNonce": 1890657298,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792218708513,
      "link": null,
      "locked": false,
      "text": "func (x *Greeter) PreStart(*goakt.Context) error {\n        return nil\n}\n\nfunc (x *Greeter) Receive(ctx *goakt.ReceiveContext) {\n        switch msg := ctx.Message().(type) {\n        case *Greet:\n                x.greeted++\n                ctx.Response(&Greeting{Message: \"hello, \" + msg.Name + \"!\"})\n        default:\n                ctx.Unhandled()\n        }\n}\n\nfunc (x *Greeter) PostStop(*goakt.Context) error {\n        return nil\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "func (x *Greeter) PreStart(*goakt.Context) error {\n        return nil\n}\n\nfunc (x *Greeter) Receive(ctx *goakt.ReceiveContext) {\n        switch msg := ctx.Message().(type) {\n        case *Greet:\n                x.greeted++\n                ctx.Response(&Greeting{Message: \"hello, \" + msg.Name + \"!\"})\n        default:\n                ctx.Unhandled()\n        }\n}\n\nfunc (x *Greeter) PostStop(*goakt.Context) error {\n        return nil\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Pm-iaVj36DQOvVYnyzoG3",
