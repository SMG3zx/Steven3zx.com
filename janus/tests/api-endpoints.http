###
POST http://localhost:8080/api/v1/uploads/source-bundles
Cookie: {{authCookie}}
Content-Type: multipart/form-data; boundary=JanusSourceBoundary

--JanusSourceBoundary
Content-Disposition: form-data; name="projectId"

{{projectId}}
--JanusSourceBoundary
Content-Disposition: form-data; name="sourceRef"

main
--JanusSourceBoundary
Content-Disposition: form-data; name="sourceKind"

zip
--JanusSourceBoundary
Content-Disposition: form-data; name="file"; filename="sample-source.zip"
Content-Type: application/zip

< ./fixtures/sample-source.zip
--JanusSourceBoundary--

###
POST http://localhost:8080/api/v1/uploads/artifacts
Cookie: {{authCookie}}
Content-Type: multipart/form-data; boundary=JanusArtifactBoundary

--JanusArtifactBoundary
Content-Disposition: form-data; name="projectId"

{{projectId}}
--JanusArtifactBoundary
Content-Disposition: form-data; name="sourceRef"

upload
--JanusArtifactBoundary
Content-Disposition: form-data; name="artifactRuntime"

wasm/wasi-http-component
--JanusArtifactBoundary
Content-Disposition: form-data; name="file"; filename="sample-module.wasm"
Content-Type: application/wasm

< ./fixtures/sample-module.wasm
--JanusArtifactBoundary--

