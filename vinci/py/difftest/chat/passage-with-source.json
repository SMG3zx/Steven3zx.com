{
  "name": "passage-with-source",
  "description": "a cited passage from a read document gets a Sources line (Mojo only)",
  "stdin": [
    "Read the glider notes.",
    "What do the glider notes say about birds?",
    "/exit"
  ],
  "replies": [
    "{\"tool\": \"read\", \"path\": \"$FILES/glider.md\"}",
    "I read it.",
    "{\"tool\": \"recall\", \"query\": \"birds steer weight shift\"}",
    "Birds steer by weight shift [d1/1]."
  ],
  "oracle": false,
  "expect": {
    "stdout_contains": [
      "Sources:",
      "- \"glider\", "
    ],
    "stdout_absent": [
      "  ! cites"
    ],
    "journal_kinds": {
      "read": 1,
      "exchange": 3
    }
  }
}
