<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>vinci</AssemblyName>
    <RootNamespace>Vinci</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Memory/Pages/*.html" LogicalName="Vinci.Memory.Pages.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Memory/Evaluation/questions.json" LogicalName="Vinci.Memory.Evaluation.questions.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Neo4j.Driver" Version="6.5.1" />
  </ItemGroup>

</Project>
