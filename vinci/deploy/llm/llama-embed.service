[Unit]
Description=vinci embeddings (Qwen3-Embedding-4B, CPU, port 8081)
After=network-online.target

[Service]
# CPU only: the chat model fills the 12 GB card. Same weights Ollama served, so the
# vector index does not need rebuilding (cosine ~0.999 against Ollama's vectors).
ExecStart=%h/src/llama.cpp/build/bin/llama-server -m %h/Steven3zx.com/vinci/models/Qwen3-Embedding-4B.gguf --embeddings --alias qwen3-embedding:4b -dev none -ngl 0 -c 8192 -ub 8192 -b 8192 -t 6 --host 127.0.0.1 --port 8081
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
