# Copy to ~/.config/vinci/memory.env. Every line is optional except the database.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# The API. With a key set, every request except the web pages must send "Authorization: Bearer <key>".
MEMORY_HOST=127.0.0.1
MEMORY_PORT=4781
MEMORY_API_KEY=
MEMORY_ADMIN_KEY=
MEMORY_MAX_BODY_BYTES=4194304
MAX_CONTENT_BYTES=1000000

# Chat in the web page goes through a local Codex App Server. Set to 1 to turn it off.
CODEX_APP_SERVER_DISABLED=0

# Turning events into memories. "model" needs MODEL_BASE_URL (any OpenAI-compatible server);
# "heuristic" only keeps events whose metadata says {"remember": true}.
CONSOLIDATION_MODE=model
MODEL_BASE_URL=
MODEL_NAME=local-model
MODEL_API_KEY=
CONSOLIDATION_REQUIRE_APPROVAL=0

# Optional services. Recall uses only the ones that are set.
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1024
RERANKER_BASE_URL=
FAITHFULNESS_JUDGE_BASE_URL=

# The audit trail is kept in memory; set a file to keep it across restarts.
AUDIT_FILE=
