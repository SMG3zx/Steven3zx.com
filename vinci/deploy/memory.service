[Unit]
Description=vinci memory API and web pages
After=network-online.target

[Service]
# Settings come from ~/.config/vinci/memory.env (see deploy/memory/memory.env.example).
EnvironmentFile=-%h/.config/vinci/memory.env
ExecStart=%h/.local/bin/vinci memory serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
